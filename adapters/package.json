{
  "name": "cowart-adapters",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "Host adapters for the Cowart fork (Claude Code, ZCode, Codex). See ../FORK.md.",
  "scripts": {
    "check:contract": "node ./claude/scripts/check-contract.mjs",
    "test:claude": "node ./claude/scripts/smoke-test.mjs && node ./claude/scripts/multi-session-test.mjs && node ./claude/scripts/generation-test.mjs && node ./service/test/feedback-test.mjs && node --test ./service/test/requests-test.mjs && node ./service/test/stop-test.mjs",
    "test:multi": "node ./claude/scripts/multi-session-test.mjs",
    "test:generation": "node ./claude/scripts/generation-test.mjs",
    "test:feedback": "node ./service/test/feedback-test.mjs",
    "test:requests": "node --test ./service/test/requests-test.mjs",
    "test:stop": "node ./service/test/stop-test.mjs",
    "test:zcode": "node ./zcode/scripts/smoke-test.mjs",
    "dev:claude": "node ./claude/scripts/dev-host.mjs",
    "install:skill": "node ./claude/scripts/install-skill.mjs",
    "uninstall:skill": "node ./claude/scripts/install-skill.mjs --remove",
    "install:zcode": "node ./zcode/scripts/install.mjs",
    "uninstall:zcode": "node ./zcode/scripts/install.mjs --remove",
    "service:status": "node ./service/bin/cowart-service.mjs --status",
    "service:stop": "node ./service/bin/cowart-service.mjs --stop",
    "feedback": "node ./service/bin/cowart-feedback.mjs",
    "build:artifacts": "node ./scripts/build-artifacts.mjs",
    "check:artifacts": "node ./scripts/build-artifacts.mjs --check",
    "probe:cold": "node ./scripts/probe-cold-install.mjs",
    "test:codex": "node --test ./codex/scripts/client-test.mjs ./codex/scripts/asset-cache-test.mjs ./service/test/widget-transport-test.mjs ./service/test/video-assets-test.mjs && node ./codex/scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "fractional-indexing": "3.2.0",
    "puppeteer-core": "25.10.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
